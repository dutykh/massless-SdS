  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"BasicPTFormula", "[", 
      RowBox[{"t_", ",", "V0_", ",", "V2_"}], "]"}], "=", 
     RowBox[{
      SqrtBox[
       RowBox[{"V0", "+", 
        FractionBox["V2", 
         RowBox[{"8", "V0"}]]}]], "-", 
      RowBox[{"\[ImaginaryI]", " ", "t", 
       SqrtBox[
        RowBox[{"-", 
         FractionBox["V2", 
          RowBox[{"2", "V0"}]]}]]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PTFormula", "[", 
      RowBox[{"U_", ",", "F_", ",", 
       RowBox[{"{", 
        RowBox[{"R_Symbol", ",", 
         RowBox[{"R0_", "?", "NumericQ"}], ",", 
         RowBox[{"FR_", ":", "FindRoot"}]}], "}"}], ",", "n_", ",", 
       RowBox[{"MyPrecision_", "/;", 
        RowBox[{"MyPrecision", ">", "0"}]}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"V", "=", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"U", ",", "R"}], "]"}], "//", "Simplify"}]}], "}"}], ",", 
        
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Res", "=", 
            RowBox[{"FR", "[", 
             RowBox[{
              RowBox[{"V", "\[Equal]", "0"}], ",", 
              RowBox[{"{", 
               RowBox[{"R", ",", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{"R0", ",", "MyPrecision"}], "]"}]}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "\[Rule]", "MyPrecision"}]}], 
             "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Prepend", "[", 
           RowBox[{"Res", ",", 
            RowBox[{
             RowBox[{"BasicPTFormula", "[", 
