               RowBox[{"n", "+", 
                FractionBox["1", "2"]}], ",", "U", ",", 
               RowBox[{"F", " ", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"F", " ", "V"}], ",", "R"}], "]"}]}]}], "]"}], "/.",
              "Res"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}], "]"}], "/;", 
      RowBox[{
       RowBox[{"NumericQ", "[", 
        RowBox[{"U", "/.", 
         RowBox[{"R", "->", "R0"}]}], "]"}], "&&", 
       RowBox[{"NumericQ", "[", 
        RowBox[{"F", "/.", 
         RowBox[{"R", "->", "R0"}]}], "]"}]}]}]}], ";"}]}]}]], "Input",
